{
	"name": "Text to SQL Developer Environment",

	"dockerComposeFile": [
		"../docker-compose.yml"
	],

	"service": "app",

	"workspaceFolder": "/text_to_sql",

	"postCreateCommand": "pip install poetry",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"googlecloudtools.cloudcode",
				"charliermarsh.ruff"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				// ターミナルのカレントディレクトリを指定
				"terminal.integrated.cwd": "/text_to_sql"
			}
		}
	},

	"remoteUser": "vscode",

	"updateRemoteUserUID": true
}
